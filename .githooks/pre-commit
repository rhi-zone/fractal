#!/usr/bin/env bash
# Real git pre-commit hook (this repo's `core.hooksPath` points at
# .githooks/ — see .git/config — separate from tooling/claude-hooks/, which
# hooks the Claude Code harness's own tool calls, not git).
#
# Blocks a commit that introduces or edits a comment (in any staged
# .ts/.tsx/.js/.jsx/.mts/.cts file) whose content-hash isn't in
# tooling/comment-approval/approved-comments.json — see
# tooling/comment-approval/README.md for the full design (why content-hash,
# why file-scoped rather than whole-repo, why the pre-existing backlog
# starts unapproved rather than bulk-approved).
#
# Scoped to STAGED files only, not the whole repo: this is what keeps the
# hook usable from day one despite the existing codebase's large unapproved
# backlog (intentionally left unapproved, not bootstrapped away — see the
# README's bootstrap-strategy section) — a commit that never touches a given
# file is never blocked by that file's pre-existing comments. Any comment in
# a file you DO touch gets checked, not just the lines your diff changed:
# whole-file scope is simple and matches lint-staged-style tooling
# elsewhere, at the cost of occasionally asking you to also approve an
# unrelated pre-existing comment that merely happens to share a file with
# your change (approve it or leave it — this hook doesn't require you to
# fix it, only to have looked at it).
#
# No --no-verify escape hatch is sanctioned (CLAUDE.md: "No --no-verify. Fix
# the issue or fix the hook.") — the remediation path is fast on purpose:
# read the flagged comment(s), then either fix the wording or run the
# `approve` command this script's own output prints.
set -uo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root" || exit 2

if ! command -v bun >/dev/null 2>&1; then
  echo "comment-approval pre-commit hook: 'bun' not found on PATH — are you inside 'nix develop'/direnv? Skipping check." >&2
  exit 0
fi

bun tooling/comment-approval/cli.ts check --staged
exit $?
