{
  "name": "@rhi-zone/fractal-monorepo",
  "private": true,
  "workspaces": [
    "packages/api-tree",
    "packages/type-ir",
    "packages/ffi-ir",
    "packages/playground",
    "packages/http-api-projector",
    "packages/http-framework-projector",
    "packages/api-explorer",
    "packages/mcp-api-projector",
    "packages/json-rpc-api-projector",
    "packages/cli-api-projector",
    "packages/graphql-api-projector",
    "packages/auth-oidc",
    "packages/fractal",
    "examples/library-api"
  ],
  "type": "module",
  "scripts": {
    "check:workspace": "tooling/check-workspace.sh --verbose",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "tooling/check-workspace.sh && bun run --filter '*' test",
    "build:packages": "tooling/check-workspace.sh && tsc -b tsconfig.build.json",
    "comments:check": "bun tooling/comment-approval/cli.ts check",
    "comments:approve": "bun tooling/comment-approval/cli.ts approve",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "bun-types": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^6.0.3"
  }
}
