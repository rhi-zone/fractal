# Build
dist/
*.tsbuildinfo

# Local build-cache byproduct written by packages/api-tree/src/cache.ts,
# never meant to be committed
*.cache.json

# Codegen scale-harness generated artifacts (regenerated by test/scale/gen.ts)
packages/codegen/test/scale/out/

# Nix
result
.direnv/

# Node
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# examples/doc-site-verification — persisted-but-not-CI-gated real
# Docusaurus/Astro site builds (see examples/doc-site-verification/README.md).
# node_modules/ and dist/ are already covered by the generic rules above;
# these cover build output/caches specific to these two site scaffolds, plus
# the MDX `bun run generate` writes (regenerated from the fixture tree, not
# meant to be committed — same footing as build/dist output here).
examples/doc-site-verification/*/build/
examples/doc-site-verification/*/.astro/
examples/doc-site-verification/*/.docusaurus/
examples/doc-site-verification/*/package-lock.json
examples/doc-site-verification/docusaurus/docs/api/
examples/doc-site-verification/starlight/src/content/docs/api/

# IDE
.idea/
.vscode/
*.swp

# Agent worktrees (temporary, never tracked)
.claude/worktrees/

# Local-only data (e.g. test corpora), never tracked
.local-data/

# Sensitive term list read by the pre-commit hook (.githooks/pre-commit),
# never tracked
.sensitive-terms.local

# Spike logs
spike/*/logs/commit.log

# Normalize
.normalize/*
!.normalize/config.toml
!.normalize/duplicate-functions-allow
!.normalize/duplicate-types-allow
!.normalize/hotspots-allow
!.normalize/large-files-allow
!.normalize/memory/
