{
  "name": "@rhi-zone/fractal-cli-api-projector",
  "version": "0.1.0-alpha.0",
  "description": "CLI projection for the function-core tree — subcommand dispatch, tag-driven confirm, codegen args",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/cli-api-projector"
  },
  "keywords": [
    "cli",
    "api",
    "projector",
    "codegen",
    "subcommands"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rhi-zone/fractal-api-tree": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
