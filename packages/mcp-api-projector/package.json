{
  "name": "@rhi-zone/fractal-mcp-api-projector",
  "version": "0.1.0-alpha.0",
  "description": "MCP tool projection for the function-core tree — toTools, annotation hints derived from meta.tags",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/mcp-api-projector"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api",
    "projector",
    "tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rhi-zone/fractal-api-tree": "workspace:*"
  },
  "devDependencies": {
    "@rhi-zone/fractal-http-api-projector": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
