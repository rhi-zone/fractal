{
  "name": "@rhi-zone/fractal-graphql-api-projector",
  "version": "0.1.0-alpha.0",
  "description": "GraphQL projection for the function-core tree — nested Query / flat Mutation+Subscription SDL assembly (via @rhi-zone/fractal-type-ir) + graphql-js resolver dispatch",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/graphql-api-projector"
  },
  "keywords": [
    "graphql",
    "api",
    "projector",
    "sdl",
    "resolvers",
    "subscriptions"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "import": "./dist/resolve.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./ws": {
      "types": "./dist/ws.d.ts",
      "import": "./dist/ws.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rhi-zone/fractal-api-tree": "workspace:*",
    "@rhi-zone/fractal-type-ir": "workspace:*",
    "graphql": "^16.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
