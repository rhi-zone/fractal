{
  "name": "@rhi-zone/fractal-json-rpc-api-projector",
  "version": "0.1.0-alpha.0",
  "description": "JSON-RPC 2.0 method projection for the function-core tree — dot-joined method names, HTTP POST + WebSocket transports, batch requests, streaming via Notifications, typed client",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/json-rpc-api-projector"
  },
  "keywords": [
    "json-rpc",
    "api",
    "projector",
    "websocket",
    "rpc"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./project": {
      "types": "./src/project.ts",
      "import": "./src/project.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./wire": {
      "types": "./src/wire.ts",
      "import": "./src/wire.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.fuzz.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rhi-zone/fractal-api-tree": "workspace:*",
    "@rhi-zone/fractal-type-ir": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  }
}
