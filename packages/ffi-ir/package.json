{
  "name": "@rhi-zone/fractal-ffi-ir",
  "version": "0.1.0-alpha.0",
  "description": "FFI intermediate representation: boundary-crossing modules/resources/function signatures over type-ir TypeRefs, plus ownership-discipline metadata — projectable to C, JS/wasm-bindgen, WIT, and other FFI targets",
  "keywords": [
    "bindings",
    "codegen",
    "ffi",
    "ffi-ir",
    "rust-c-abi",
    "wasm-bindgen",
    "wit"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/ffi-ir"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rust-c-abi": {
      "types": "./dist/rust-c-abi.d.ts",
      "import": "./dist/rust-c-abi.js"
    },
    "./wit": {
      "types": "./dist/wit.d.ts",
      "import": "./dist/wit.js"
    },
    "./rust-wasm-bindgen": {
      "types": "./dist/rust-wasm-bindgen.d.ts",
      "import": "./dist/rust-wasm-bindgen.js"
    },
    "./rescript-external": {
      "types": "./dist/rescript-external.d.ts",
      "import": "./dist/rescript-external.js"
    },
    "./gleam-external": {
      "types": "./dist/gleam-external.d.ts",
      "import": "./dist/gleam-external.js"
    },
    "./ocaml-melange": {
      "types": "./dist/ocaml-melange.d.ts",
      "import": "./dist/ocaml-melange.js"
    },
    "./typescript-deno": {
      "types": "./dist/typescript-deno.d.ts",
      "import": "./dist/typescript-deno.js"
    },
    "./typescript-bun": {
      "types": "./dist/typescript-bun.d.ts",
      "import": "./dist/typescript-bun.js"
    },
    "./csharp-pinvoke": {
      "types": "./dist/csharp-pinvoke.d.ts",
      "import": "./dist/csharp-pinvoke.js"
    },
    "./java-jni": {
      "types": "./dist/java-jni.d.ts",
      "import": "./dist/java-jni.js"
    },
    "./python-ctypes": {
      "types": "./dist/python-ctypes.d.ts",
      "import": "./dist/python-ctypes.js"
    },
    "./ruby-ffi": {
      "types": "./dist/ruby-ffi.d.ts",
      "import": "./dist/ruby-ffi.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@rhi-zone/fractal-type-ir": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
