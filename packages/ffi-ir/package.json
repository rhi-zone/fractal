{
  "name": "@rhi-zone/fractal-ffi-ir",
  "version": "0.1.0-alpha.0",
  "description": "FFI intermediate representation: boundary-crossing modules/resources/function signatures over type-ir TypeRefs, plus ownership-discipline metadata — projectable to C, JS/wasm-bindgen, WIT, and other FFI targets",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/ffi-ir"
  },
  "keywords": [
    "ffi-ir",
    "ffi",
    "bindings",
    "codegen",
    "wasm-bindgen",
    "wit",
    "c-abi"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./c-abi": {
      "types": "./dist/c-abi.d.ts",
      "import": "./dist/c-abi.js"
    },
    "./wit": {
      "types": "./dist/wit.d.ts",
      "import": "./dist/wit.js"
    },
    "./wasm-bindgen": {
      "types": "./dist/wasm-bindgen.d.ts",
      "import": "./dist/wasm-bindgen.js"
    },
    "./rescript": {
      "types": "./dist/rescript.d.ts",
      "import": "./dist/rescript.js"
    },
    "./gleam": {
      "types": "./dist/gleam.d.ts",
      "import": "./dist/gleam.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rhi-zone/fractal-type-ir": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
