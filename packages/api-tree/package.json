{
  "name": "@rhi-zone/fractal-api-tree",
  "version": "0.1.0-alpha.0",
  "description": "Function-core model — function category (Fn/compose/pipe) + Result + Kleisli/applicative combinators (composeK/collect); Node/Op/Meta model in ./node; Tags lattice in ./tags",
  "keywords": [
    "api",
    "auth",
    "cli",
    "codegen",
    "combinators",
    "function-core",
    "otel"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/api-tree"
  },
  "bin": {
    "fractal-api-tree": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./tags": {
      "types": "./dist/tags.d.ts",
      "import": "./dist/tags.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./apply-validation": {
      "types": "./dist/apply-validation.d.ts",
      "import": "./dist/apply-validation.js"
    },
    "./apply-validation-build": {
      "types": "./dist/apply-validation-build.d.ts",
      "import": "./dist/apply-validation-build.js"
    },
    "./schema-build": {
      "types": "./dist/schema-build.d.ts",
      "import": "./dist/schema-build.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./reachability": {
      "types": "./dist/reachability.d.ts",
      "import": "./dist/reachability.js"
    },
    "./discover": {
      "types": "./dist/discover.d.ts",
      "import": "./dist/discover.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@rhi-zone/fractal-type-ir": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rhi-zone/fractal-cli-api-projector": "workspace:*",
    "@rhi-zone/fractal-graphql-api-projector": "workspace:*",
    "@rhi-zone/fractal-http-api-projector": "workspace:*",
    "@rhi-zone/fractal-mcp-api-projector": "workspace:*",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
