{
  "name": "@rhi-zone/fractal-auth-oidc",
  "version": "0.1.0-alpha.0",
  "description": "Generic OIDC/JWT auth adapter for fractal — server-side JWKS-backed JWT validation (AuthAdapter) and client-side OAuth token lifecycle management (AuthClientAdapter), both via Web Crypto (no JWT library dependency)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhi-zone/fractal.git",
    "directory": "packages/auth-oidc"
  },
  "keywords": [
    "oidc",
    "jwt",
    "jwks",
    "oauth",
    "auth",
    "web-crypto"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "import": "./dist/jwt.js"
    },
    "./jwks": {
      "types": "./dist/jwks.d.ts",
      "import": "./dist/jwks.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rhi-zone/fractal-api-tree": "workspace:*"
  },
  "devDependencies": {
    "@rhi-zone/fractal-http-api-projector": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
